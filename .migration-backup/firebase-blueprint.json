{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "A media post created by an admin",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the post" },
        "imageUrl": { "type": "string", "description": "URL of the uploaded image" },
        "roast": { "type": "string", "description": "Brutal English roast caption" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string", "enum": ["Trending", "Latest", "Economy Roasts", "Politics", "Memes", "Illustrations"] },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" },
        "adminId": { "type": "string" },
        "reactionsCount": { "type": "number" },
        "commentsCount": { "type": "number" }
      },
      "required": ["title", "imageUrl", "roast", "category", "createdAt", "adminId"]
    },
    "Reaction": {
      "title": "Reaction",
      "description": "User reaction to a post",
      "type": "object",
      "properties": {
        "emoji": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["emoji", "userId", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comment on a post",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["text", "userId", "userName", "status", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin user profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    },
    "User": {
       "title": "User",
       "description": "User profile",
       "type": "object",
       "properties": {
         "displayName": { "type": "string" },
         "avatarUrl": { "type": "string" }
       }
    }
  },
  "firestore": {
    "posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Stores all media posts"
    },
    "posts/{postId}/reactions/{reactionId}": {
      "schema": { "$ref": "#/entities/Reaction" },
      "description": "Stores reactions on a post"
    },
    "posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Stores comments on a post"
    },
    "admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Stores admin privileges"
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores normal user base info"
    }
  }
}
